# Copy to .env on the server. Never commit .env.
POSTGRES_PASSWORD=change-me-long-random
# ":80" = temporary host on the server IP over HTTP; later "maximov-tech.ru" for automatic HTTPS
SUNS_SITE_ADDRESS=:80
SUNS_PUBLIC_URL=http://localhost
SUNS_ENV=prod
# invite | open
SUNS_REGISTRATION=invite
# Real-money trading for the whole service. Keep false until the owner decides otherwise.
SUNS_LIVE_TRADING_ENABLED=false
