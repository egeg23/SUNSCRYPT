# SUNSCRYPT — сайт хостового nginx. Ставит infra/deploy.sh: подставляет адрес
# (__HOST__), все имена сайта (__NAMES__: адрес и прежние адреса) и порт
# приложения (__PORT__), строки сертификата дописывает certbot. Повторная
# выкатка меняет в готовом файле только имена и порт.
server {
    listen 80;
    listen [::]:80;
    server_name __NAMES__;

    # До запуска — закрыто от поиска.
    add_header X-Robots-Tag "noindex, nofollow" always;
    client_max_body_size 5m;

    location / {
        # Прежний адрес — на постоянный (проверка certbot идёт мимо: у неё
        # своя точная location).
        if ($host != "__HOST__") {
            return 301 https://__HOST__$request_uri;
        }
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Дашборд в реальном времени — WebSocket и SSE: без буфера и с
        # долгим ожиданием.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
